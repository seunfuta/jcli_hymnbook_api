        {
            "id": 83,
            "title": "Emi 'ba le b'Olorun rin",
            "language": "yoruba",
            "group": " Lenti ati Ironupiwada",
            "tunelink": [
                "https://www.ileewe.org/hymns/51-100/audios/Hymn%2080.mp3"
            ],
            "verses": [
                [
                    "1.Emi 'ba le b'Olorun rin",
                    "K'iwa mi jo t'Orun",
                    "Ki nri imole, ti'nto mi",
                    "Sodo Od'aguntan!"
                ],
                [
                    "2.Ibukun ti mo ni ha da,",
                    "'Gba mo ko mo Kristi?",
                    "Itura okan na ha da",
                    "T'oro Jesu fun mi?"
                ],
                [
                    "3.Alaafia ni igbana apo?",
                    "'Ranti Re ti dun to,",
                    "Nisiyi okan mi sojo",
                    "Ti aye ko le di."
                ],
                [
                    "4.Pada, Emi Mimo, pada",
                    "Ojise itunu",
                    "Mo ko ese wonni sile,",
                    "T'o le O l’okan mi."
                ],
                [
                    "5.Ohun ti mo ba fe julo,",
                    "Ohun to wu ko je",
                    "Ba mi yo kuro l'okan mi,",
                    "Ki nle sin 'wo nikan"
                ],
                [
                    "6.Be ni ngo le b'Olorun rin,",
                    "Iwa mi y'o tuntun",
                    "'Mole mimo y'o ma to mi",
                    "Sodo Od'aguntan.   Amin."
                ]
            ],
            "chorus": "",
            "addedChorus": ""
        },
        {
            "id": 80,
            "title": "O for a closer walk with God,",
            "language": "english",
            "group": " Lent and Repentance",
            "tunelink": [
                "https://www.ileewe.org/hymns/51-100/audios/Hymn%2080.mp3"
            ],
            "verses": [
                [
                    "1.O for a closer walk with God,",
                    "A calm and heavenly frame,",
                    "A light to shine upon the road",
                    "That leads me to the Lamb!"
                ],
                [
                    "2.Where is the blessedness I knew,",
                    "When first I saw the Lord?",
                    "Where is the soul refreshing view",
                    "Of Jesus and His Word?"
                ],
                [
                    "3.What peaceful hours I once enjoyed!",
                    "How sweet their memory still!",
                    "But they have left an aching void",
                    "The world can never fill."
                ],
                [
                    "4.Return, O holy Dove, return,",
                    "Sweet messenger of rest!",
                    "I hate the sins that made Thee mourn",
                    "And drove Thee from my breast."
                ],
                [
                    "5.The dearest idol I have known,",
                    "Whate’er that idol be",
                    "Help me to tear it from Thy throne,",
                    "And worship only Thee."
                ],
                [
                    "6.So shall my walk be close with God,",
                    "Calm and serene my frame;",
                    "So purer light shall mark the road",
                    "That leads me to the Lamb.",
                    "Amen."
                ]
            ],
            "chorus": "",
            "addedChorus": ""
        },